-- DICTIONARY --
-- Note names are not part of the language - they are defined as "vocabulary" that are substituted for pitch classes when invoked

C: 0 C#: 1 D: 2 D#: 3 E: 4 F: 5 F#: 6 G: 7 G#: 8 A: 9 B: 11

a:
  (
    90 bpm..122 bpm..134 bpm..134 bpm..90 bpm
    {
      (
        @4 d16 B A G# A d8 @5 C ~ d16 D C @4 B @5 C d8 E ~ d16 F E D# E B A G# A B A G# A @6 d8 C ~ d16 @5 A ~ @6 C d32 ~
        @5  (d64 G A d16 B ~ { F# A } ~ { E G } ~ { F# A } d32 ~) * 2
        @5 d64 G A d16 B ~ { F# A } ~  { E G } ~ { D# F# } ~ d8 E ~
      )
      (
        d16 (~ * 4) d16 (@3 A ~ (@4 { C E } ~ ) * 3) * 2 d16 @3 A ~ @4 { C E } ~ @3 A ~ @4 { C E } ~ @3 A ~ (@4 { C E } ~ ) * 3
        ( d16 @3 E ~ ({ @3 B @4 E } d16 ~) * 3) * 2 @3 E ~ { B @4 E} ~  @2 B ~ { @3 B @4 E } ~ d8 E ~
      )
    }
  )

b:
  (
    (
      100 bpm..122 bpm..134 bpm..134 bpm..90 bpm
      {
       (
          @5 mp d16 { C E } ~ { D F } ~ { E G } ~ { E G } ~ A G F E d8 @4 { 11 14 } 7
          @5 mp d16 { C E } ~ { D F } ~ { E G } ~ { E G } ~ A G F E d4 @4 { 11 14 }
          @4 mp d16 { 9 12 } ~ { 11 14 } ~ @5 { C E } ~ { C E } ~ F E D C @4 d8 { G# B } E
          @4 mp d16 { 9 12 } ~ { 11 14 } ~ @5 { C E } ~ { C E } ~ F E D C @4 d4 { G# B }
        )
        (
          mp d16 (~ * 4) @3 d16 f C ~ 12 ~ E ~ 16 ~ d4 G ~ d16 C ~ 12 ~ E ~ 16 ~ d8 G ~
          mp d16 (~ * 4) @2 d16 ff A ~ 21 ~ @3 C ~ 12 ~ d8 E ~ d4 ~ d16 pp @2 A ~ 21 ~ @3 C ~ 12 ~ d4 E
        )
      }
    )
    _ (
      100 bpm..134 bpm..134 bpm..134 bpm..90 bpm
      p..p..p..p..p..f
      {
        (
          @4 d16 B A G# A d8 @5 C ~ d16 D C @4 B @5 C d8 E ~ d16 F E D# E B A G# A B A G# A @6 d4 C
        )
        (
          d16 (~ * 4) d16 (@3 A ~ (@4 { C E } ~ ) * 3) * 2 d16 @3 A ~ @4 { C E } ~ @3 A ~ @4 { C E } ~ @3 F ~ {@3 A @4 D# } ~
        )
      }

    )
    100 bpm..111 bpm
    (
      {
        (
         p d16 @5 A ~ B ~
        )
        (
          p d16 { @3 A @4 D# } ~ { @3 A @4 D# } ~
        )
      }
    ) _
    122 bpm..134 bpm..134 bpm..100 bpm
    (

      {
        (
          p d16 @5 12 ~ B ~ A ~ G# ~ A ~ E ~ F ~ D ~ d4 C d32 @4 11 12 11 12 11 12 9 11 d4 A
        )
        (
          p d16 @3 E ~ {@3 B @4 E } ~ @3 D ~ { F B } ~ C ~ { E A } ~ D ~ { F B } ~
          { E A } ~ { E A } ~ { E G# } ~ { E G# } ~ d4 { @2 A @3 A }
        )
      }
    )
  )

  c:
    (
      {
        (
          100 bpm..122 bpm..134 bpm..134 bpm..100 bpm
          {

            ( @5 ff d16 A ~ B ~ d4 13 d16 A ~ B ~ 13 ~ B ~ A ~ G# ~ F# ~ G# ~ A ~ B ~ G# ~ E ~ A ~ B ~ d4 13 d16 A ~ B ~ 13 ~ B ~ A ~ G# ~ F# ~ B ~ G# ~ E ~ d4 A)
            ( @4 ff  d16 A ~ B ~ d4 13 d16 A ~ B ~ 13 ~ B ~ A ~ G# ~ F# ~ G# ~ A ~ B ~ G# ~ E ~ A ~ B ~ d4 13 d16 A ~ B ~ 13 ~ B ~ A ~ G# ~ F# ~ B ~ G# ~ E ~ d4 A)
            (
              ff
              d16 ( ~ ) * 3 d64 ~ @2 A @3 C# E d16 A ~ A ~ A ~ A d64 ~ @2 A @3 C# E d16 A ~ A ~ A ~ A
              d64 ~ @2 D F# A d16 @3 D ~ D d64 ~ D# F# A d16 @3 D# ~ D# d64 ~ @2 E G# B @3 d16 E ~ E ~ E ~ E
              d64 ~ @2 A @3 C# E d16 A ~ A ~ A ~ A d64 ~ @2 A @3 C# E d16 A ~ A ~ A ~ A d64 @2 ~ D F# A d16 @3 D ~ D
              d64 ~ @2 E G# B @3 d16 E ~ E ~ @2 d4 A
            )
