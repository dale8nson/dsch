program       = _{ SOI ~ exps ~ EOI }
exps          =  { exp+ }
exp           =  { simple | compound }
simple        =  { scalar | decl | prefix | infix | suffix | ident }
decl          =  { ident ~ ":" ~ exp }
ident         = @{ (ASCII_ALPHA | "_") ~ ((ASCII_ALPHANUMERIC | "_" | symbol )* ~ prime*) | ((ASCII_ALPHANUMERIC | "_")* ~ " " ~ (ASCII_ALPHA_UPPER | ASCII_DIGIT)*) }
scalar        =  { dynamic | frequency | tempo | pure | duration | rest | prog }
dynamic       =  { ppp | pp | p | mp | mf | fff | ff | f }
ppp           =  { "ppp" }
pp            =  { "pp" }
p             =  { "p" }
mp            =  { "mp" }
mf            =  { "mf" }
f             =  { "f" }
ff            =  { "ff" }
fff           =  { "fff" }
duration      = ${ fixed | fractional }
fixed         = ${ (minutes | seconds | minutes ~ seconds) }
frequency     = ${ absolute ~ "Hz" }
tempo         = ${ pure ~ "bpm" }
minutes       = ${ absolute ~ "'" }
seconds       = ${ absolute ~ "\"" }
fractional    = ${ "d" ~ (tuplet | rational | absolute) }
tuplet        = ${ absolute ~ ":" ~ absolute }
exponent      = @{ ("e" | "E") ~ ("+" | "-")? ~ ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* }
compound      =  { parens | braces | brackets | ratio }
parens        =  { "(" ~ exps ~ ")" }
braces        =  { "{" ~ exps ~ "}" }
brackets      =  { "[" ~ exp ~ ("," ~ exp)* ~ "]" }
ratio         = ${ integer ~ (":" ~ integer)+ }
pure          =  { relative | absolute }
relative      = ${ sign ~ absolute }
sign          =  { plus | minus }
absolute      =  { float | integer }
rational      = ${ absolute ~ "/" ~ absolute }
integer       = @{ ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* | zero }
float         = @{ (ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*) ~ point ~ ASCII_DIGIT+ ~ exponent? | zero ~ point ~ ASCII_DIGIT+ ~ exponent? }
prefix        =  { pc | reg | dur }
suffix        =  { amp | bpm | freq }
infix         = ${ (plus | minus | mul | div | colon | intercalate | range | interpolation)+ }
colon         =  { ":" }
intercalate   =  { "><" }
plus          =  { "+" }
minus         =  { "-" }
mul           =  { "*" }
div           =  { "/" }
range         =  { ".." }
interpolation =  { increase | decrease }
increase      =  { "<" }
decrease      =  { ">" }
bpm           =  { "bpm" }
pc            =  { "pc" }
prog          =  ${ "#" ~ integer }
reg           =  { "@" }
dur           =  { "d" }
rest          =  { "~" }
freq          =  { "Hz" }
amp           =  { "^" }
prime         =  { "`" }
point         =  { "." }
zero          =  { "0" }
symbol = { "!" | "@" | "#" | "%" | "^" | "&" | "*" | "-" | "+" | "=" | "<" | ">" | ";" | "~" | "|" | "/" | "\\" }
// space = { " " }
WHITESPACE    = _{ " " | "\t" | "\r" | "\n" }
COMMENT       = _{ "--" ~ (!("\n") ~ ANY)* }
