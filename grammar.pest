program       = _{ SOI ~ exps ~ EOI }
exps          =  { exp+ }
exp           =  { decl | simple | compound }
simple        =  { scalar | prefix | infix | suffix | ident }
decl          =  { importdecl | expdecl | funcdecl }
importdecl    =  { "import" ~ ident }
expdecl       =  { ident ~ ":" ~ exp }
funcdecl      =  { ident ~ (param)+ ~ "=" ~ funcdef }
param         =  { ident }
funcdef       =  { exps }
ident         = @{ (ASCII_ALPHA | "_") ~ (("\\ " | ASCII_ALPHANUMERIC | "_" | symbol)* ~ prime*) }
scalar        =  { dynamic | frequency | tempo | pure | rest | prog }
dynamic       =  { ppp | pp | p | mp | mf | fff | ff | f }
ppp           =  { "ppp" }
pp            =  { "pp" }
p             =  { "p" }
mp            =  { "mp" }
mf            =  { "mf" }
f             =  { "f" }
ff            =  { "ff" }
fff           =  { "fff" }
// duration      = ${ fixed | fractional }
// fixed         = ${ (minutes | seconds | minutes ~ seconds) }
frequency     = ${ pure ~ "Hz" }
tempo         = ${ pure ~ "bpm" }
// minutes       = ${ absolute ~ "'" }
// seconds       = ${ absolute ~ "\"" }
// fractional    = ${ "d" ~ (tuplet | rational | absolute) }
// tuplet        = ${ absolute ~ ":" ~ absolute }
exponent      = @{ ("e" | "E") ~ ("+" | "-")? ~ ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* }
compound      =  { parens | braces | brackets | ratio }
parens        =  { "(" ~ exps ~ ")" }
braces        =  { "{" ~ exps ~ "}" }
brackets      =  { "[" ~ exp ~ ("," ~ exp)* ~ "]" }
ratio         = ${ integer ~ (":" ~ integer)+ }
pure          =  { rational | relative | absolute }
relative      = ${ sign ~ absolute }
sign          =  { plus | minus }
absolute      =  { float | integer }
rational      = ${ absolute ~ "/" ~ absolute }
integer       = @{ ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* | zero }
float         = @{ (ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*) ~ point ~ ASCII_DIGIT+ ~ exponent? | zero ~ point ~ ASCII_DIGIT+ ~ exponent? }
prefix        =  { reg | dur | hash }
suffix        =  { amp | bpm | freq }
infix         = ${ (plus | minus | mul | div | colon | intercalate | range | interpolation | arrow)+ }
colon         =  { ":" }
intercalate   =  { "><" }
plus          =  { "+" }
minus         =  { "-" }
mul           =  { "*" }
div           =  { "/" }
range         =  { ".." }
interpolation =  { controls | increase | decrease }
controls      =  { "<" ~ scalar ~ (range ~ scalar)+ ~ ">" }
arrow         =  { "->" }
increase      =  { "<" }
decrease      =  { ">" }
bpm           =  { "bpm" }
prog          = ${ "#" ~ integer }
hash          =  { "#" }
reg           =  { "@" }
dur           =  { "d" }
rest          =  { "~" }
freq          =  { "Hz" }
amp           =  { "^" }
prime         =  { "`" }
point         =  { "." }
zero          =  { "0" }
symbol        =  { "!" | "@" | "#" | "%" | "^" | "&" | "*" | "-" | "+" | "=" | "<" | ">" | ";" | "~" | "|" | "/" | "\\" }
WHITESPACE    = _{ " " | "\t" | "\r" | "\n" }
COMMENT       = _{ "--" ~ (!("\n") ~ ANY)* }
